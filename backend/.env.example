# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000,https://your-frontend-domain.vercel.app"

# Database Connection (SQLite)
# Local development:
DATABASE_URL="file:./dev.db"
# Production on Render with Persistent Disk mounted at /var/data:
# DATABASE_URL="file:/var/data/prod.db"
# Production on Railway with Volume mounted at /data:
# DATABASE_URL="file:/data/prod.db"

# Authentication
JWT_SECRET="generate_a_secure_random_32_byte_hex_string"
JWT_EXPIRES_IN="7d"

# SMTP Email Configuration (Nodemailer / Optional)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="EventHive <noreply@eventhive.campus>"
